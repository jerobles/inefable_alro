---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pago confirmado" description="Confirmación de pago — Inefable ALRO" noindex>
  <section class="confirmado">
    <div class="grain"></div>
    <div class="container confirmado__content">
      <p class="kicker reveal" data-estado-kicker>Procesando...</p>
      <h1 class="reveal" data-estado-titulo>Un momento…</h1>
      <p class="confirmado__sub reveal" data-estado-texto>Estamos confirmando tu pago.</p>

      <p class="confirmado__numero reveal" data-numero-caja hidden>
        Número de pedido: <strong data-numero-pedido></strong>
      </p>

      <p class="confirmado__ayuda reveal">
        ¿Algo no cuadra con tu pedido?
        <a href="https://wa.me/573021101969?text=%C2%A1Hola!%20Tengo%20una%20duda%20sobre%20mi%20pedido%20%F0%9F%95%AF%EF%B8%8F" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </p>

      <div class="confirmado__links reveal">
        <a href="/tienda" class="btn btn-ghost">Volver al catálogo</a>
        <a href="/curso" class="btn btn-ghost">Volver a talleres</a>
      </div>
    </div>
  </section>

  <script>
    function safe(fn: () => void, name: string) {
      try { fn(); } catch (e) { console.warn('[' + name + ']', e); }
    }

    function initEstadoPago() {
      const params = new URLSearchParams(window.location.search);
      const tipo = params.get('tipo'); // 'taller' | 'producto'
      const estado = params.get('collection_status') || params.get('status'); // 'approved' | 'pending' | ...

      const kicker = document.querySelector('[data-estado-kicker]');
      const titulo = document.querySelector('[data-estado-titulo]');
      const texto = document.querySelector('[data-estado-texto]');
      if (!kicker || !titulo || !texto) return;

      const cosa = tipo === 'taller' ? 'tu cupo en el taller' : 'tu pedido';

      // Mercado Pago devuelve el numero de pedido que le mandamos como referencia.
      const numeroPedido = params.get('external_reference') || '';
      const cajaNumero = document.querySelector('[data-numero-pedido]');
      if (cajaNumero && /^IA-/.test(numeroPedido)) {
        cajaNumero.textContent = numeroPedido;
        (cajaNumero.closest('[data-numero-caja]') as HTMLElement).hidden = false;
      }

      if (estado === 'pending' || estado === 'in_process') {
        kicker.textContent = 'Pago en proceso';
        titulo.textContent = 'Estamos confirmando tu pago';
        texto.textContent = `Tu pago está siendo revisado. Apenas se confirme te escribimos por correo con la confirmación de ${cosa}.`;
      } else {
        // Por defecto asumimos aprobado: Mercado Pago solo trae hasta acá con
        // auto_return cuando el pago quedó aprobado (o cuando entra manual sin ese dato).
        kicker.textContent = '¡Pago confirmado!';
        titulo.textContent = 'Gracias por tu compra';
        // Ya pagó y ya dejó sus datos: no hay nada que "coordinar". Mandarlo a
        // WhatsApp acá sobra y hace sentir que el pedido quedó a medias.
        texto.textContent = tipo === 'taller'
          ? 'Ya recibimos tu pago y tu cupo quedó reservado. Te enviamos la confirmación por correo con todos los detalles del taller.'
          : 'Ya recibimos tu pago y tu pedido está en preparación. Te enviamos la confirmación por correo con el detalle de lo que compraste.';

        // El pedido se completó: el carrito ya cumplió su función.
        try { (window as any).carritoInefable?.vaciar(); } catch (e) { /* da igual */ }
      }
    }

    document.addEventListener('DOMContentLoaded', () => safe(initEstadoPago, 'initEstadoPago'));
  </script>

  <style>
    .confirmado {
      position: relative;
      min-height: 70vh;
      display: flex;
      align-items: center;
      background: var(--bg-2);
      padding: 160px 0 80px;
    }
    .confirmado__content { max-width: 620px; }
    .confirmado__sub { font-size: 1.05rem; margin-top: 16px; max-width: 480px; }
    .confirmado__numero {
      margin-top: 26px;
      padding: 12px 16px;
      display: inline-block;
      background: var(--bg-3);
      border-left: 2px solid var(--accent);
      font-size: 0.9rem;
      color: var(--cream-2);
    }
    .confirmado__numero[hidden] { display: none; }
    .confirmado__numero strong { color: var(--cream); letter-spacing: 0.04em; }
    /* WhatsApp queda como salida de emergencia, no como el siguiente paso: el
       pedido ya está cerrado y pagado. */
    .confirmado__ayuda { margin-top: 30px; font-size: 0.88rem; color: var(--cream-3); }
    .confirmado__ayuda a { color: var(--accent); text-decoration: underline; }
    .confirmado__links { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; }
  </style>
</Layout>
