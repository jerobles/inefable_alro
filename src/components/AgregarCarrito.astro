---
// Bloque "Agregar al carrito" de la página de producto: presentación + cantidad + botón.
//
// No trae script propio: el cerebro del carrito (CarritoDrawer.astro, cargado desde el
// Layout) escucha los clics por delegación. Este componente solo deja los datos del
// producto en atributos para que aquel los lea.
import type { CollectionEntry } from 'astro:content';

interface Props {
  producto: CollectionEntry<'productos'>;
}

const { producto } = Astro.props;
const p = producto.data;

const formatPrecio = (n: number) => n.toLocaleString('es-CO');
const soloCotizacion = p.variantes.every((v) => v.precio === undefined);
---

<div
  class="agregar"
  data-agregar
  data-slug={producto.slug}
  data-nombre={p.nombre}
  data-imagen={p.imagen}
>
  <div class="agregar__campos">
    <label class="agregar__campo">
      Presentación
      <select data-agregar-presentacion>
        {p.variantes.map((v) => (
          <option value={v.presentacion} data-precio={v.precio !== undefined ? String(v.precio) : undefined}>
            {v.presentacion}
            {v.precio !== undefined ? ` — $${formatPrecio(v.precio)}` : ' — Por cotización'}
          </option>
        ))}
      </select>
    </label>

    <label class="agregar__campo agregar__campo--cantidad">
      Cantidad
      <input type="number" min="1" max="50" value="1" data-agregar-cantidad />
    </label>
  </div>

  <button type="button" class="btn btn-primary agregar__btn" data-agregar-btn>
    Agregar al carrito
  </button>

  {soloCotizacion && (
    <p class="agregar__nota">
      Este producto se cotiza según lo que necesites. Agrégalo igual: te escribimos por
      WhatsApp con el precio antes de cobrar nada.
    </p>
  )}
</div>

<style>
  .agregar {
    margin-top: 28px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .agregar__campos {
    display: grid;
    grid-template-columns: 1fr 110px;
    gap: 14px;
    margin-bottom: 18px;
  }
  .agregar__campo {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream-3);
  }
  .agregar__campo select,
  .agregar__campo input {
    padding: 12px 14px;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--cream);
    font-family: inherit;
    font-size: 0.92rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .agregar__campo select:focus,
  .agregar__campo input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .agregar__btn { width: 100%; justify-content: center; }
  .agregar__nota {
    margin: 14px 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--cream-3);
  }

  @media (max-width: 520px) {
    .agregar__campos { grid-template-columns: 1fr; }
  }
</style>
