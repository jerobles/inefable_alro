---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/#historia', label: 'Nuestra historia' },
  { href: '/tienda', label: 'Tienda' },
  { href: '/curso', label: 'Taller de velas' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="site-header" data-nav>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <img src="/images/logo-badge.svg" alt="Inefable ALRO" width="56" height="56" />
      <span>Inefable <em>ALRO</em></span>
    </a>

    <div class="site-header__acciones">
      <button class="site-header__carrito" data-carrito-abrir aria-label="Ver mi pedido">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M6 7h12l-1 12H7L6 7z" stroke-linejoin="round" />
          <path d="M9 7a3 3 0 0 1 6 0" stroke-linecap="round" />
        </svg>
        <span class="site-header__contador" data-carrito-contador hidden>0</span>
      </button>

      <button class="site-header__toggle" data-nav-toggle aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="site-header__nav" data-nav-menu>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <div class="site-header__ctas">
        <a href="/tienda" class="btn btn-ghost site-header__cta">Ver catálogo</a>
        <a href="/curso" class="btn btn-primary site-header__cta">Reserva tu cupo</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 22px 0;
    transition: background .35s ease, padding .35s ease, border-color .35s ease;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: rgba(22, 17, 12, 0.92);
    backdrop-filter: blur(10px);
    padding: 14px 0;
    border-color: var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .site-header__brand img {
    border-radius: 50%;
    background: var(--cream);
    padding: 4px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .site-header__brand em { color: var(--gold); font-style: italic; }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }
  .site-header__nav a {
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    color: var(--cream-2);
    transition: color .2s ease;
  }
  .site-header__nav a:hover { color: var(--accent); }
  .site-header__ctas { display: flex; align-items: center; gap: 10px; }
  .site-header__cta { padding: 10px 18px; font-size: 0.78rem; white-space: nowrap; }
  /* El "ghost" del catálogo compite menos visualmente que el ámbar del taller,
     pero queda al mismo nivel jerárquico: son las dos cosas que se venden. */
  .site-header__ctas .btn-ghost { border-color: rgba(243,234,217,0.28); }

  /* El carrito queda siempre visible (también en móvil, fuera del menú lateral):
     es el acceso al pedido en curso, no un enlace de navegación más. */
  .site-header__acciones {
    display: flex;
    align-items: center;
    gap: 6px;
    /* En el HTML va antes del menú (para que en móvil quede junto a la hamburguesa),
       pero visualmente pertenece a la derecha, con los botones de acción. */
    order: 3;
  }
  .site-header__carrito {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--cream-2);
    cursor: pointer;
    padding: 8px;
    transition: color .2s ease;
  }
  .site-header__carrito:hover { color: var(--accent); }
  .site-header__contador {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.65rem;
    font-weight: 500;
    line-height: 17px;
    text-align: center;
  }
  .site-header__contador[hidden] { display: none; }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .site-header__toggle span {
    width: 22px;
    height: 1.5px;
    background: var(--cream);
  }

  @media (max-width: 860px) {
    .site-header__toggle { display: flex; }
    .site-header__nav {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: min(300px, 80vw);
      background: var(--bg-2);
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 40px;
      gap: 28px;
      transform: translateX(100%);
      transition: transform .35s ease;
      border-left: 1px solid var(--line);
    }
    .site-header__nav.is-open { transform: translateX(0); }
    /* En el menú lateral los dos botones se apilan a lo ancho, sin apretarse */
    .site-header__ctas {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 12px;
      margin-top: 8px;
    }
    .site-header__cta { justify-content: center; padding: 13px 18px; }
  }
</style>
